{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd lt-client && npm install && npm run build",
  "outputDirectory": "lt-client/dist",
  "installCommand": "cd lt-client && npm install",
  "devCommand": "cd lt-client && npm start",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
