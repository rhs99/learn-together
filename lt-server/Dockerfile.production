FROM node:22.17-slim

# Set working directory
WORKDIR /app

# Copy package files from lt-server directory
COPY lt-server/package.json lt-server/package-lock.json ./

# Install production dependencies only
RUN npm ci --omit=dev

# Copy application code from lt-server directory
COPY lt-server/ .

# Create logs directory
RUN mkdir -p logs

# Expose port (Railway will set PORT env var)
EXPOSE 5000

# Set production environment
ENV NODE_ENV=production

# Start the application
CMD ["npm", "start"]
